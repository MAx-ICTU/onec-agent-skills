// Учебный серверный модуль. Цены постоянны на время всей операции.
Процедура ЗаполнитьЦены(Строки) Экспорт

    Для Каждого СтрокаДанных Из Строки Цикл
        Запрос = Новый Запрос;
        Запрос.Текст =
            "ВЫБРАТЬ Цены.Цена
            |ИЗ РегистрСведений.УчебныеФиксированныеЦены КАК Цены
            |ГДЕ Цены.Товар = &Товар";
        Запрос.УстановитьПараметр("Товар", СтрокаДанных.Товар);
        Выборка = Запрос.Выполнить().Выбрать();
        СтрокаДанных.ЕстьЦена = Выборка.Следующий();
        Если СтрокаДанных.ЕстьЦена Тогда
            СтрокаДанных.Цена = Выборка.Цена;
        Иначе
            СтрокаДанных.Цена = 0;
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры
