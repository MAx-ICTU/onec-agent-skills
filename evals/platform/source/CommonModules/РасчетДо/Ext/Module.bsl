// Самостоятельный учебный пример. Серверный общий модуль, без БСП и метаданных.
Процедура ПересчитатьТовары(Товары) Экспорт

    Для Каждого СтрокаТовара Из Товары Цикл
        СуммаДоСкидки = Окр(СтрокаТовара.Количество * СтрокаТовара.Цена, 2);
        СуммаПослеСкидки = Окр(СуммаДоСкидки
            * (100 - СтрокаТовара.СкидкаПроцент) / 100, 2);
        СтрокаТовара.Сумма = СуммаПослеСкидки;
    КонецЦикла;

КонецПроцедуры

// Добавить к before.bsl ИЛИ after.bsl в тестовом серверном общем модуле.
Процедура ПроверитьУчебныйРасчет() Экспорт

    Товары = Новый ТаблицаЗначений;
    Для Каждого ИмяКолонки Из СтрРазделить("Количество,Цена,СкидкаПроцент,Сумма", ",") Цикл
        Товары.Колонки.Добавить(ИмяКолонки);
    КонецЦикла;
    ПересчитатьТовары(Товары);
    Если Товары.Количество() <> 0 Тогда
        ВызватьИсключение "Изменился пустой набор";
    КонецЕсли;

    СтрокаТовара = Товары.Добавить();
    СтрокаТовара.Количество = 2;
    СтрокаТовара.Цена = 0.503;
    СтрокаТовара.СкидкаПроцент = 20;
    СтрокаТовара.Сумма = -1;
    ПересчитатьТовары(Товары);
    Если СтрокаТовара.Сумма <> 0.81 Тогда
        ВызватьИсключение "Нарушен порядок округления";
    КонецЕсли;

КонецПроцедуры
