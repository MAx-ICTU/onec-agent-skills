// Учебный серверный общий модуль.
// Предполагаются корректные входы и неизменность цен/доступности записей.
Процедура ЗаполнитьЦены(Строки) Экспорт

    Если Строки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |    ИсходныеСтроки.ИдентификаторСтроки КАК ИдентификаторСтроки,
        |    ИсходныеСтроки.Товар КАК Товар
        |ПОМЕСТИТЬ ВТИсходныеСтроки
        |ИЗ
        |    &ИсходныеСтроки КАК ИсходныеСтроки
        |;
        |
        |ВЫБРАТЬ
        |    ИсходныеСтроки.ИдентификаторСтроки КАК ИдентификаторСтроки,
        |    ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
        |    ВЫБОР
        |        КОГДА Цены.Товар ЕСТЬ NULL ТОГДА ЛОЖЬ
        |        ИНАЧЕ ИСТИНА
        |    КОНЕЦ КАК ЕстьЦена
        |ИЗ
        |    ВТИсходныеСтроки КАК ИсходныеСтроки
        |        ЛЕВОЕ СОЕДИНЕНИЕ
        |            РегистрСведений.УчебныеФиксированныеЦены КАК Цены
        |        ПО ИсходныеСтроки.Товар = Цены.Товар";

    Запрос.УстановитьПараметр("ИсходныеСтроки", Строки);
    Выборка = Запрос.Выполнить().Выбрать();

    РезультатыПоСтрокам = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        РезультатСтроки = Новый Структура("Цена,ЕстьЦена",
            Выборка.Цена, Выборка.ЕстьЦена);
        РезультатыПоСтрокам.Вставить(
            Выборка.ИдентификаторСтроки, РезультатСтроки);
    КонецЦикла;

    Для Каждого СтрокаДанных Из Строки Цикл
        РезультатСтроки = РезультатыПоСтрокам.Получить(
            СтрокаДанных.ИдентификаторСтроки);
        СтрокаДанных.Цена = РезультатСтроки.Цена;
        СтрокаДанных.ЕстьЦена = РезультатСтроки.ЕстьЦена;
    КонецЦикла;

КонецПроцедуры
