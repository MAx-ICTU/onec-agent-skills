// Самостоятельный учебный пример. Серверный общий модуль; вызов вне транзакции.
Процедура ВыполнитьОперацию(Знач ИмитироватьСбой, Трасса) Экспорт

    НачатьТранзакцию();
    Попытка
        ВыполнитьШаг(ИмитироватьСбой, Трасса);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("onec-agent-skills.УчебнаяОперация",
            УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
        ВызватьИсключение;
    КонецПопытки;
    Трасса.Добавить("Успех");

КонецПроцедуры

Процедура ВыполнитьШаг(Знач ИмитироватьСбой, Трасса)

    Если ИмитироватьСбой Тогда
        ВызватьИсключение "Учебный сбой шага";
    КонецЕсли;
    Трасса.Добавить("Шаг");

КонецПроцедуры

// Добавить к after.bsl в отдельном тестовом серверном общем модуле.
Процедура ПроверитьУчебнуюОперацию() Экспорт

    Трасса = Новый Массив;
    ВыполнитьОперацию(Ложь, Трасса);
    Если Трасса.Количество() <> 2 Тогда
        ВызватьИсключение "Неверная длина успешной трассы";
    КонецЕсли;
    Если Трасса[0] <> "Шаг" Или Трасса[1] <> "Успех" Тогда
        ВызватьИсключение "Неверный порядок успешной трассы";
    КонецЕсли;

    Трасса = Новый Массив;
    ПолученоИсключение = Ложь;
    Попытка
        ВыполнитьОперацию(Истина, Трасса);
    Исключение
        ПолученоИсключение = Истина;
    КонецПопытки;
    Если Не ПолученоИсключение Или Трасса.Количество() <> 0 Тогда
        ВызватьИсключение "Сбой должен прерывать операцию без сигнала успеха";
    КонецЕсли;
    Если ТранзакцияАктивна() Тогда
        ВызватьИсключение "Осталась незавершенная транзакция";
    КонецЕсли;

КонецПроцедуры
