Процедура Проверить(Факт, Ожидание, Имя, Лог)
    Если Факт <> Ожидание Тогда
        ВызватьИсключение Имя + ": ожидалось " + Строка(Ожидание) + ", получено " + Строка(Факт);
    КонецЕсли;
    Лог.Добавить("PASS|" + Имя + "|" + Строка(Факт));
КонецПроцедуры

Функция Прочитать(Путь)
    Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
    Результат = Чтение.Прочитать();
    Чтение.Закрыть();
    Возврат Результат;
КонецФункции

Функция ВыполнитьЗапрос(Путь, Документ = Неопределено)
    Запрос = Новый Запрос(Прочитать(Путь));
    Если Документ <> Неопределено Тогда
        Запрос.УстановитьПараметр("Документ", Документ);
    КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ЗаписатьЛог(Итог, Лог)
    Запись = Новый ЗаписьТекста("{{RUN_ROOT}}/platform/results.txt", КодировкаТекста.UTF8);
    Запись.ЗаписатьСтроку("1C training 8.5.1.1150; compatibility Version8_5_1; file database; no configured users/roles");
    Для Каждого СтрокаЛога Из Лог Цикл
        Запись.ЗаписатьСтроку(СтрокаЛога);
    КонецЦикла;
    Запись.ЗаписатьСтроку(Итог);
    Запись.Закрыть();
КонецПроцедуры

Процедура Метка(Товар, Имя, Активна)
    Запись = РегистрыСведений.УчебныеМетки.СоздатьМенеджерЗаписи();
    Запись.Товар = Товар;
    Запись.Метка = Имя;
    Запись.Активна = Активна;
    Запись.Записать();
КонецПроцедуры

Процедура Цена(Товар, Значение)
    Запись = РегистрыСведений.УчебныеФиксированныеЦены.СоздатьМенеджерЗаписи();
    Запись.Товар = Товар;
    Запись.Цена = Значение;
    Запись.Записать();
КонецПроцедуры

Процедура ИсторическаяЦена(Момент, Товар, Источник, Значение)
    Запись = РегистрыСведений.УчебныеЦены.СоздатьМенеджерЗаписи();
    Запись.Период = Момент;
    Запись.Товар = Товар;
    Запись.Источник = Источник;
    Запись.Цена = Значение;
    Запись.Записать();
КонецПроцедуры

Функция Срез(Путь, Момент)
    Запрос = Новый Запрос(Прочитать(Путь));
    Запрос.УстановитьПараметр("Дата", Момент);
    Запрос.УстановитьПараметр("Источник", "ручной");
    Т = Запрос.Выполнить().Выгрузить();
    Т.Сортировать("Товар");
    Результат = "";
    Для Каждого Стр Из Т Цикл
        Результат = Результат + Стр.Товар + ":" + Строка(Стр.Цена) + ";";
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ТаблицаСтрок(Ключи)
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    Т.Колонки.Добавить("Товар", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
    Т.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
    Т.Колонки.Добавить("ЕстьЦена", Новый ОписаниеТипов("Булево"));
    Для Каждого Ключ Из Ключи Цикл
        Стр = Т.Добавить();
        Стр.ИдентификаторСтроки = Т.Количество();
        Стр.Товар = Ключ;
        Стр.Цена = -999;
        Стр.ЕстьЦена = Истина;
    КонецЦикла;
    Возврат Т;
КонецФункции

Функция ОбразСтрок(Т)
    Образ = "";
    Для Каждого Стр Из Т Цикл
        Образ = Образ + Строка(Стр.ИдентификаторСтроки) + ":" + Стр.Товар + ":" + Строка(Стр.Цена) + ":" + Строка(Стр.ЕстьЦена) + ";";
    КонецЦикла;
    Возврат Образ;
КонецФункции

Процедура ПроверитьЦены(Ключи, Имя, Лог)
    До = ТаблицаСтрок(Ключи);
    После = ТаблицаСтрок(Ключи);
    ЦеныДо.ЗаполнитьЦены(До);
    ЦеныАгент.ЗаполнитьЦены(После);
    Проверить(ОбразСтрок(После), ОбразСтрок(До), "Q4.agent." + Имя, Лог);
    Повтор = ТаблицаСтрок(Ключи);
    ЦеныАгентПовтор.ЗаполнитьЦены(Повтор);
    Проверить(ОбразСтрок(Повтор), ОбразСтрок(До), "Q4.agent-repeat." + Имя, Лог);
    Пример = ТаблицаСтрок(Ключи);
    ЦеныПример.ЗаполнитьЦены(Пример);
    Проверить(ОбразСтрок(Пример), ОбразСтрок(До), "Q4.example." + Имя, Лог);
КонецПроцедуры

Процедура ЗапуститьПроверки() Экспорт
    Лог = Новый Массив;
    Попытка
        // Изолированная база; свежие записи создаются только здесь.
        Док = Документы.УчебнаяПродажа.СоздатьДокумент();
        Док.Дата = Дата(2026, 1, 1);
        Для Индекс = 1 По 3 Цикл
            Стр = Док.Товары.Добавить();
            Стр.Товар = ?(Индекс = 3, "B", "A");
            Стр.Сумма = ?(Индекс = 3, 50, 100);
        КонецЦикла;
        Док.Записать();
        Метка("A", "T1", Истина);
        Метка("A", "T2", Истина);
        Метка("B", "T3", Ложь);
        Путь = "{{RUN_ROOT}}/";
        Т = ВыполнитьЗапрос(Путь + "Q2/input/before.query", Док.Ссылка);
        Проверить(Т[0].Сумма, 400, "Q2.fixture.before", Лог);
        Т = ВыполнитьЗапрос(Путь + "Q2/artifacts/proposed.query", Док.Ссылка);
        Проверить(Т[0].Сумма, 200, "Q2.fixture.agent", Лог);
        Т = ВыполнитьЗапрос("{{PROJECT_ROOT}}/examples/query-review/join-multiplication/after.query", Док.Ссылка);
        Проверить(Т[0].Сумма, 200, "Q2.fixture.example", Лог);
        Т = ВыполнитьЗапрос("{{PROJECT_ROOT}}/examples/query-review/correct.query", Док.Ссылка);
        Т.Сортировать("Товар");
        Проверить(Т.Количество(), 2, "Q5.rows", Лог);
        Проверить(Т[0].Сумма, 200, "Q5.A", Лог);
        Проверить(Т[1].Сумма, 50, "Q5.B", Лог);
        Метка("A", "T2", Ложь);
        Т = ВыполнитьЗапрос(Путь + "Q2/artifacts/proposed.query", Док.Ссылка);
        Проверить(Т[0].Сумма, 200, "Q2.one-active.real-repeats", Лог);
        Метка("A", "T1", Ложь);
        Т = ВыполнитьЗапрос(Путь + "Q2/artifacts/proposed.query", Док.Ссылка);
        Лог.Добавить("OBSERVED|Q2.no-active.rows=" + Строка(Т.Количество()));
        Если Т.Количество() > 0 Тогда
            Лог.Добавить("OBSERVED|Q2.no-active.sum-null=" + Строка(Т[0].Сумма = NULL));
        КонецЕсли;
        ПустДок = Документы.УчебнаяПродажа.СоздатьДокумент();
        ПустДок.Дата = Дата(2026, 1, 1);
        ПустДок.Записать();
        Т = ВыполнитьЗапрос(Путь + "Q2/artifacts/proposed.query", ПустДок.Ссылка);
        Лог.Добавить("OBSERVED|Q2.empty-document.rows=" + Строка(Т.Количество()));
        Если Т.Количество() > 0 Тогда
            Лог.Добавить("OBSERVED|Q2.empty-document.sum-null=" + Строка(Т[0].Сумма = NULL));
        КонецЕсли;

        Для Каждого ИмяТовара Из СтрРазделить("A,B,C", ",") Цикл
            Об = Справочники.УчебныеТовары.СоздатьЭлемент();
            Об.Наименование = ИмяТовара;
            Об.Записать();
            Если ИмяТовара <> "C" Тогда
                Р = РегистрыСведений.УчебныеРазрешения.СоздатьМенеджерЗаписи();
                Р.Товар = Об.Ссылка;
                Р.Активна = ИмяТовара = "A";
                Р.Комментарий = ?(Р.Активна, "допущен", "закрыт");
                Р.Записать();
            КонецЕсли;
        КонецЦикла;
        Т = ВыполнитьЗапрос(Путь + "Q3/input/before.query");
        Проверить(Т.Количество(), 1, "Q3.before.rows", Лог);
        Т = ВыполнитьЗапрос(Путь + "Q3/artifacts/proposed.query");
        Проверить(Т.Количество(), 3, "Q3.agent.rows", Лог);
        Для Каждого Стр Из Т Цикл
            Если Стр.Товар.Наименование = "A" Тогда
                Проверить(Стр.Комментарий, "допущен", "Q3.A.comment", Лог);
            Иначе
                Проверить(Стр.Комментарий = NULL, Истина, "Q3." + Стр.Товар.Наименование + ".null", Лог);
            КонецЕсли;
        КонецЦикла;

        Цена("A", 10);
        Цена("B", 20);
        Цена("Z", 0);
        ПроверитьЦены(СтрРазделить("A,B,A,C,Z", ","), "fixture", Лог);
        ПроверитьЦены(Новый Массив, "empty", Лог);
        ПроверитьЦены(СтрРазделить("Z", ","), "single-zero", Лог);
        ПроверитьЦены(СтрРазделить("C,C", ","), "all-missing", Лог);
        ПроверитьЦены(СтрРазделить("A,A,A", ","), "repeats", Лог);

        РасчетДо.ПроверитьУчебныйРасчет();
        Лог.Добавить("PASS|R.before.check.bsl");
        РасчетПосле.ПроверитьУчебныйРасчет();
        Лог.Добавить("PASS|R.after.check.bsl");
        ОтладкаПосле.ПроверитьУчебнуюОперацию();
        Лог.Добавить("PASS|D.after.check.bsl");
        Трасса = Новый Массив;
        ОтладкаДо.ВыполнитьОперацию(Истина, Трасса);
        Проверить(Трасса.Количество(), 1, "D.before.trace-length", Лог);
        Проверить(Трасса[0], "Успех", "D.before.false-success", Лог);
        Проверить(ТранзакцияАктивна(), Ложь, "D.no-active-transaction", Лог);

        ИсторическаяЦена(Дата(2026, 1, 1), "A", "ручной", 10);
        ИсторическаяЦена(Дата(2026, 1, 2), "A", "импорт", 12);
        ИсторическаяЦена(Дата(2026, 1, 1), "B", "ручной", 20);
        Сценарии = Новый Массив;
        Сценарии.Добавить(Новый Структура("Дата,Исходный,Кандидат", Дата(2025, 12, 31, 23, 59, 59), "", ""));
        Сценарии.Добавить(Новый Структура("Дата,Исходный,Кандидат", Дата(2026, 1, 1), "A:10;B:20;", "A:10;B:20;"));
        Сценарии.Добавить(Новый Структура("Дата,Исходный,Кандидат", Дата(2026, 1, 1, 23, 59, 59), "A:10;B:20;", "A:10;B:20;"));
        Сценарии.Добавить(Новый Структура("Дата,Исходный,Кандидат", Дата(2026, 1, 2), "B:20;", "A:10;B:20;"));
        Сценарии.Добавить(Новый Структура("Дата,Исходный,Кандидат", Дата(2026, 1, 3), "B:20;", "A:10;B:20;"));
        НомерСценария = 0;
        Для Каждого Сценарий Из Сценарии Цикл
            НомерСценария = НомерСценария + 1;
            Проверить(Срез("{{PROJECT_ROOT}}/examples/query-review/slice-last/original.query", Сценарий.Дата), Сценарий.Исходный, "Q1.original." + Строка(НомерСценария), Лог);
            Проверить(Срез("{{PROJECT_ROOT}}/examples/query-review/slice-last/proposed.query", Сценарий.Дата), Сценарий.Кандидат, "Q1.proposed." + Строка(НомерСценария), Лог);
        КонецЦикла;
        ПроверитьЦены(СтрРазделить("a,A ", ","), "case-and-space", Лог);
        ЗаписатьЛог("ALL EXECUTED ASSERTIONS PASSED", Лог);
    Исключение
        Если ТранзакцияАктивна() Тогда
            ОтменитьТранзакцию();
        КонецЕсли;
        ЗаписатьЛог("FAIL|" + ОписаниеОшибки(), Лог);
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
