// Учебный серверный модуль. Цены постоянны на время всей операции.
Процедура ЗаполнитьЦены(Строки) Экспорт

    Если Строки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    Товары = Новый Массив;
    Для Каждого СтрокаДанных Из Строки Цикл
        Товары.Добавить(СтрокаДанных.Товар);
    КонецЦикла;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ Цены.Товар, Цены.Цена
        |ИЗ РегистрСведений.УчебныеФиксированныеЦены КАК Цены
        |ГДЕ Цены.Товар В (&Товары)";
    Запрос.УстановитьПараметр("Товары", Товары);
    ЦеныПоТоварам = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        ЦеныПоТоварам.Вставить(Выборка.Товар, Выборка.Цена);
    КонецЦикла;

    Для Каждого СтрокаДанных Из Строки Цикл
        Цена = ЦеныПоТоварам.Получить(СтрокаДанных.Товар);
        СтрокаДанных.ЕстьЦена = Цена <> Неопределено;
        Если СтрокаДанных.ЕстьЦена Тогда
            СтрокаДанных.Цена = Цена;
        Иначе
            СтрокаДанных.Цена = 0;
        КонецЕсли;
    КонецЦикла;

КонецПроцедуры
